{
  "openapi": "3.0.3",
  "info": {
    "title": "Medusa API",
    "description": "Medusa API specifications",
    "version": "1.0.0",
    "contact": {
      "name": "HMPPS Digital Studio",
      "email": "feedback@digital.justice.gov.uk"
    }
  },
  "components": {
    "schemas": {
      "CreateMedusaUserRequest": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/CreateMedusaUserData"
          }
        }
      },
      "CreateMedusaUserData": {
        "type": "object",
        "required": [
          "prisonId",
          "offenderNo"
        ],
        "properties": {
          "prisonId": {
            "type": "string",
            "description": "The prison identifier",
            "example": "MDI"
          },
          "offenderNo": {
            "type": "string",
            "description": "The prisoner's offender number",
            "example": "A1234BC"
          }
        }
      },
      "GetBasketRequest": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/GetBasketRequestData"
          }
        }
      },
      "GetBasketRequestData": {
        "type": "object",
        "required": [
          "offenderNo"
        ],
        "properties": {
          "offenderNo": {
            "type": "string",
            "description": "The prisoner's offender number",
            "example": "A1234BC"
          },
          "cartId": {
            "type": "string",
            "description": "ID of medusa cart, if already created",
            "example": "cart_01M6EJSR29XNFFAFPVMJZPQZ2W"
          }
        }
      },
      "GetBasketResponse": {
        "type": "object",
        "properties": {
          "cartId": {
            "type": "string",
            "description": "ID of medusa cart",
            "example": "cart_01M6GHP256ZVB7N9MVKTNBG73A"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BasketLineItem"
            }
          },
          "itemCount": {
            "type": "number",
            "description": "Total quantity of all items",
            "example": 5
          },
          "allItemsTotal": {
            "type": "number",
            "description": "Total value of all items in basket",
            "example": 50
          },
          "draftOrderId": {
            "type": "string",
            "description": "Draft order Id, if a draft order exists",
            "example": "123"
          }
        }
      },
      "BasketLineItem": {
        "type": "object",
        "properties": {
          "lineItemId": {
            "type": "string",
            "description": "The medusa line item ID",
            "example": "cali_01M6GHP27VFW7096R5AQ0G5EHT"
          },
          "variantId": {
            "type": "string",
            "description": "The medusa product variant ID",
            "example": "variant_01M6E4F0KWV67V7JV3TN7DMAM7"
          },
          "title": {
            "type": "string",
            "description": "Product title",
            "example": "Mars Bar"
          },
          "quantity": {
            "type": "integer",
            "description": "Quantity in cart",
            "example": 3
          },
          "unitPrice": {
            "type": "number",
            "description": "Price per item",
            "example": 85
          },
          "lineTotal": {
            "type": "number",
            "description": "Overall item price",
            "example": 255
          }
        }
      },
      "AddLineItemsRequest": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/AddLineItemsRequestData"
          }
        }
      },
      "AddLineItemsRequestData": {
        "type": "object",
        "required": [
          "prisonId",
          "offenderNo",
          "productVariantId"
        ],
        "properties": {
          "prisonId": {
            "type": "string",
            "description": "The prison identifier",
            "example": "MDI"
          },
          "offenderNo": {
            "type": "string",
            "description": "The prisoner's offender number",
            "example": "A1234BC"
          },
          "cartId": {
            "type": "string",
            "description": "ID of medusa cart",
            "example": "cart_01M6EJSR29XNFFAFPVMJZPQZ2W"
          },
          "productVariantId": {
            "type": "string",
            "description": "The variant Id of the product to add to cart",
            "example": "var_1234"
          },
          "canteenWindowEnd": {
            "type": "string",
            "format": "datetime",
            "description": "The end date of the current canteen window",
            "example": "2024-05-26T14:23:16Z"
          }
        }
      },
      "AddLineItemsResponse": {
        "type": "object",
        "required": [
          "cartId"
        ],
        "properties": {
          "cartId": {
            "type": "string",
            "description": "ID of medusa cart",
            "example": "cart_01M6EJSR29XNFFAFPVMJZPQZ2W"
          }
        }
      },
      "RemoveLineItemsRequest": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/RemoveLineItemsRequestData"
          }
        }
      },
      "RemoveLineItemsRequestData": {
        "type": "object",
        "required": [
          "cartId",
          "lineItemId",
          "quantity"
        ],
        "properties": {
          "cartId": {
            "type": "string",
            "description": "ID of medusa cart",
            "example": "cart_01M6EJSR29XNFFAFPVMJZPQZ2W"
          },
          "lineItemId": {
            "type": "string",
            "description": "The ID of the line item to remove from the cart",
            "example": "var_1234"
          },
          "quantity": {
            "type": "string",
            "description": "The new quantity of the line item, when quantity hits 0, delete item from basket",
            "example": "var_1234"
          }
        }
      },
      "RemoveLineItemsResponse": {
        "type": "object",
        "required": [
          "cartId"
        ],
        "properties": {
          "cartId": {
            "type": "string",
            "description": "ID of medusa cart",
            "example": "cart_01M6EJSR29XNFFAFPVMJZPQZ2W"
          }
        }
      },
      "RemoveBasketRequest": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/RemoveBasketData"
          }
        }
      },
      "RemoveBasketData": {
        "type": "object",
        "required": [
          "cartId"
        ],
        "properties": {
          "cartId": {
            "type": "string",
            "description": "ID of medusa cart",
            "example": "cart_01M6EJSR29XNFFAFPVMJZPQZ2W"
          }
        }
      },
      "CreateDraftOrderRequest": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/CreateDraftOrderRequestData"
          }
        }
      },
      "CreateDraftOrderRequestData": {
        "type": "object",
        "properties": {
          "draftOrderId": {
            "type": "string",
            "description": "The draft order ID, if draft order already exists",
            "example": "ord_123"
          }
        }
      },
      "CreateDraftOrderResponse": {
        "type": "object",
        "required": [
          "draftOrderId"
        ],
        "properties": {
          "draftOrderId": {
            "type": "string",
            "description": "The draft order ID",
            "example": "ord_123"
          }
        }
      },
      "GetDraftOrderResponse": {
        "type": "object",
        "required": [
          "hasDraftOrder"
        ],
        "properties": {
          "hasDraftOrder": {
            "type": "boolean",
            "description": "Denotes whether a draft order exists",
            "example": true
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DraftOrderLineItem"
            }
          },
          "itemCount": {
            "type": "integer",
            "description": "Total quantity of all items in order",
            "example": 5
          },
          "subtotal": {
            "type": "number",
            "description": "Order subtotal before tax",
            "example": 1250
          },
          "total": {
            "type": "number",
            "description": "Order total",
            "example": 1500
          }
        }
      },
      "DraftOrderLineItem": {
        "type": "object",
        "required": [
          "title",
          "quantity",
          "unitPrice",
          "lineTotal"
        ],
        "properties": {
          "title": {
            "type": "string",
            "description": "Product title",
            "example": "Banana"
          },
          "quantity": {
            "type": "integer",
            "description": "Quantity in order",
            "example": 3
          },
          "unitPrice": {
            "type": "number",
            "description": "Price per unit",
            "example": 85
          },
          "lineTotal": {
            "type": "number",
            "description": "Total for this line item",
            "example": 255
          }
        }
      },
      "CancelDraftOrderRequest": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/CancelDraftOrderRequestData"
          }
        }
      },
      "CancelDraftOrderRequestData": {
        "type": "object",
        "properties": {
          "draftOrderId": {
            "type": "string",
            "description": "The draft order ID to be canceled",
            "example": "ord_123"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "integer",
            "example": 500
          },
          "errorCode": {
            "type": "string"
          },
          "userMessage": {
            "type": "string"
          },
          "developerMessage": {
            "type": "string"
          },
          "moreInfo": {
            "type": "string"
          }
        }
      }
    }
  },
  "paths": {
    "/internal/canteen/orders/cancel-draft-order": {
      "post": {
        "operationId": "cancelOrder",
        "summary": "Cancel Medusa Order",
        "description": "Cancels an in draft medusa order\n",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CancelDraftOrderRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Draft order has successfully been canceled"
          },
          "500": {
            "description": "Failed to cancel draft order",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/internal/canteen/get-draft-order/{id}": {
      "get": {
        "operationId": "getDraftOrder",
        "summary": "Get a draft order and its items",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "order_01M7AM87CYVP7V81VYQ1K1D7R1"
          }
        ],
        "responses": {
          "200": {
            "description": "Draft order successfully retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetDraftOrderResponse"
                }
              }
            }
          },
          "404": {
            "description": "Draft order not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Failed to get draft order",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/internal/canteen/orders/[id]/create-draft-order": {
      "post": {
        "operationId": "createDraftOrder",
        "summary": "Creates a draft order within medusa",
        "description": "Creates draft order, If no draftOrderId in request, we create a new draft oder and add the carts items into it, If a draftOrder is provided, we take the items from the cart, and add those items into existing draft order.\n",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateDraftOrderRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Medusa draft order successfully created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateDraftOrderResponse"
                }
              }
            }
          },
          "500": {
            "description": "Failed to create draft order",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/internal/canteen/create-user": {
      "post": {
        "operationId": "createMedusaUser",
        "summary": "Create a Medusa User",
        "description": "Creates a Medusa user for a prisoner. Linking prisoner to customer\n",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateMedusaUserRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully created Medusa user"
          },
          "500": {
            "description": "Failed to create cart",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/internal/canteen/carts/remove-line-item": {
      "post": {
        "operationId": "removeLineItem",
        "summary": "Remove line Item",
        "description": "Removes a line item from the medusa cart\n",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RemoveLineItemsRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Items successfully removed from cart",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RemoveLineItemsResponse"
                }
              }
            }
          },
          "500": {
            "description": "Failed to create cart",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/internal/canteen/carts/remove-basket": {
      "post": {
        "operationId": "removeBasket",
        "summary": "Remove Medusa Basket",
        "description": "Remove Medusa Basket\n",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RemoveBasketRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Medusa cart successfully removed"
          },
          "500": {
            "description": "Failed to remove cart",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/internal/canteen/carts/get-basket": {
      "post": {
        "operationId": "getMedusaBasket",
        "summary": "Get the medusa basket and details, if it exists and any draft orders",
        "description": "Get the medusa basket and details, if it exists and any draft orders\n",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GetBasketRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Medusa basket and order successfully retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetBasketResponse"
                }
              }
            }
          },
          "500": {
            "description": "Failed to create cart",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/internal/canteen/carts/add-line-item": {
      "post": {
        "operationId": "addLineItem",
        "summary": "Add item to existing cart, or create new cart and add item",
        "description": "Where a medusa cart already exists, add the product variant to the cart. If no cart exists, create a new cart and add the product variant.\n",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddLineItemsRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Items successfully added to cart",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AddLineItemsResponse"
                }
              }
            }
          },
          "500": {
            "description": "Failed to add line items to cart",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "tags": []
}