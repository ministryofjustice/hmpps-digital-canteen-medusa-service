{
  "name": "@dtc/backend",
  "version": "0.0.1",
  "description": "A starter for Medusa projects.",
  "author": "Medusa (https://medusajs.com)",
  "license": "MIT",
  "keywords": [
    "sqlite",
    "postgres",
    "typescript",
    "ecommerce",
    "headless",
    "medusa"
  ],
  "scripts": {
    "build": "medusa build",
    "start": "medusa start",
    "dev": "medusa develop",
    "test:integration:http": "TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:modules": "TEST_TYPE=integration:modules NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit",
    "test:unit": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit",
    "db:migrate": "npx medusa db:migrate",
    "setup": "npm ci --legacy-peer-deps && hmpps-npm-script-run-allowlist"
  },
  "dependencies": {
    "@medusajs/admin-sdk": "^2.14.1",
    "@medusajs/caching": "2.14.1",
    "@medusajs/cli": "2.14.1",
    "@medusajs/draft-order": "2.14.1",
    "@medusajs/framework": "2.14.1",
    "@medusajs/medusa": "2.14.1",
    "zod": "4.2.0",
    "@ministryofjustice/hmpps-npm-script-allowlist": "0.0.4"
  },
  "devDependencies": {
    "@medusajs/test-utils": "2.14.1",
    "@swc/core": "^1.10.1",
    "@swc/jest": "^0.2.37",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.0.0",
    "jest": "^29.7.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "yalc": "^1.0.0-pre.53"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.8.0"
}
